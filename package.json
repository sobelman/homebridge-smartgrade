{
  "name": "homebridge-smartgrade",
  "displayName": "SmartGrade Secure (Dealor)",
  "type": "module",
  "version": "0.1.0",
  "private": false,
  "description": "Homebridge plugin for SmartGrade Secure / IoTech Verticals / Dealor (דילאור) cloud smart switches: boiler switches, sockets and light switches, with SMS login from the Homebridge UI and a per-device HomeKit accessory type (Switch / Outlet / Valve).",
  "author": "sobelman",
  "license": "MIT",
  "homepage": "https://github.com/sobelman/homebridge-smartgrade#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sobelman/homebridge-smartgrade.git"
  },
  "bugs": {
    "url": "https://github.com/sobelman/homebridge-smartgrade/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "homekit",
    "smartgrade",
    "dealor",
    "iotech",
    "iotechv",
    "boiler",
    "water-heater",
    "switch",
    "israel"
  ],
  "main": "dist/src/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "README.he.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.18.0 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc -p tsconfig.json && node scripts/copy-ui.mjs",
    "lint": "eslint . --max-warnings=0 && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "watch": "npm run build && npm link",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@homebridge/hap-nodejs": "^2.3.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "homebridge": "^2.5.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
